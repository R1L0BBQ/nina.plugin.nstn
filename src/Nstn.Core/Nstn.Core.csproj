<Project Sdk="Microsoft.NET.Sdk">

  <!-- The NSTN night model without any NINA or WPF dependency, so it builds and is
       tested anywhere, including the Linux SDK container. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nstn.Core</RootNamespace>
    <AssemblyName>Nstn.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version the golden fixtures were generated with (tests/golden/README.md). -->
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web planner's filter tables, copied unchanged from astro-public. -->
    <EmbeddedResource Include="Filters\dnb-filter.csv" />
    <EmbeddedResource Include="Filters\schmalband-filter.csv" />
    <!-- The user-facing texts, one table per language (Text.cs). In the assembly
         itself, not in satellite assemblies: the plugin stays one folder of DLLs. -->
    <EmbeddedResource Include="Strings\*.json" WithCulture="false" LogicalName="Nstn.Core.Strings.%(Filename).json" />
  </ItemGroup>

</Project>
