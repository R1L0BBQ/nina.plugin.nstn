<ResourceDictionary
    x:Class="NINA.Plugin.Nstn.Conditions.ConditionTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.Nstn.Conditions"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <BooleanToVisibilityConverter x:Key="NstnBooleanToVisibility" />

    <!--  Advanced Sequencer: band and bandwidth, tonight's window below them, the state now on the right.  -->
    <DataTemplate DataType="{x:Type local:NstnWindowCondition}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Filter" />
                        <ComboBox
                            MinWidth="230"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding PresetChoices}"
                            SelectedValue="{Binding SelectedPreset}"
                            SelectedValuePath="Name"
                            ToolTip="Takes band and bandwidth from the NSTN filter tables. A suggestion: check the passbands of your own filter." />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Band" />
                        <ComboBox
                            MinWidth="130"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding AvailableBands}"
                            SelectedValue="{Binding Line}"
                            SelectedValuePath="Key" />
                        <ninactrl:UnitTextBox
                            MinWidth="50"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding IsBandwidthEditable}"
                            Text="{Binding BandwidthNm, UpdateSourceTrigger=LostFocus}"
                            TextAlignment="Right"
                            ToolTip="Bandwidth (FWHM) of the filter for this line"
                            Unit="nm"
                            Visibility="{Binding IsNarrowband, Converter={StaticResource NstnBooleanToVisibility}}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,3,0,0"
                        Opacity="0.8"
                        Text="{Binding PresetHint}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasPresetHint, Converter={StaticResource NstnBooleanToVisibility}}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Opacity="0.8"
                        Text="{Binding WindowSummary}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
            <view:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding NowSummary}" />
            </view:SequenceBlockView.SequenceItemProgressContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!--  Imaging tab mini sequencer. The key is the fully qualified type name plus "_Mini".  -->
    <DataTemplate x:Key="NINA.Plugin.Nstn.Conditions.NstnWindowCondition_Mini">
        <mini:MiniCondition>
            <mini:MiniCondition.ConditionProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding ShortLabel}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding NowSummary}" />
                </StackPanel>
            </mini:MiniCondition.ConditionProgressContent>
        </mini:MiniCondition>
    </DataTemplate>
</ResourceDictionary>
