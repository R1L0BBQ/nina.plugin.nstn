<ResourceDictionary
    x:Class="NINA.Plugin.Nstn.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.Nstn"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary">

    <!--  NINA looks the options page up as AssemblyTitle + "_Options"; the data context is NstnPlugin.  -->
    <DataTemplate x:Key="NSTN – Narrowband Saves The Night_Options">
        <StackPanel Margin="5" Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,10"
                Text="Settings of the active profile. The site's own sky quality is required; the thresholds are calibrated defaults and only need changing for bright sites."
                TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Sky quality at the zenith (SQM)" />
                <ninactrl:UnitTextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding SkyQuality, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="0 = not set. A measured value, not a Bortle guess." />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Threshold broadband (L/RGB)" />
                <ninactrl:UnitTextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding ThresholdBroadband, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="Default 20.6" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Threshold narrowband (in band)" />
                <ninactrl:UnitTextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding ThresholdNarrowband, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="Default 23.1" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Minimum target altitude" />
                <ninactrl:UnitTextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding MinimumAltitude, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="°" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="Default 20" />

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Night plan: overhead per exposure" />
                <ninactrl:UnitTextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding OverheadSeconds, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="s" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="Download, saving, dithering on average. Only for the estimate. Default 10" />
            </Grid>

            <TextBlock
                Margin="0,10,0,0"
                Opacity="0.8"
                Text="{Binding NarrowbandFloorText}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Opacity="0.8"
                Text="Site latitude and longitude come from the NINA profile (Options > General > Astrometry); times are shown in this PC's local time."
                TextWrapping="Wrap" />

            <!--  What each filter of the profile passes, for "From this block's filter" in the condition.  -->
            <TextBlock
                Margin="0,18,0,4"
                FontWeight="Bold"
                Text="Filters of this profile" />
            <TextBlock
                Opacity="0.8"
                Text="What each filter of the filter wheel list passes. A condition set to 'From this block's filter' takes its band from here, so changing the filter of a Smart Exposure changes the band with it. Suggestions are only applied on request; a bandwidth is never guessed."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Opacity="0.8"
                Text="The profile has no filters in its filter wheel list (Options > Equipment > Filter Wheel)."
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProfileFilters}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding FilterRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding NinaName}"
                                TextTrimming="CharacterEllipsis" />
                            <ComboBox
                                Grid.Column="1"
                                Margin="5,0"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Source={x:Static local:FilterAssignmentRow.Choices}}"
                                SelectedValue="{Binding Choice}"
                                SelectedValuePath="Name" />
                            <ComboBox
                                Grid.Column="2"
                                Margin="5,0"
                                DisplayMemberPath="Label"
                                IsEnabled="{Binding HasLine}"
                                ItemsSource="{Binding AvailableBands}"
                                SelectedValue="{Binding Line}"
                                SelectedValuePath="Key" />
                            <ninactrl:UnitTextBox
                                Grid.Column="3"
                                Margin="5,0"
                                IsEnabled="{Binding IsBandwidthEditable}"
                                Text="{Binding BandwidthNm, UpdateSourceTrigger=LostFocus}"
                                TextAlignment="Right"
                                Unit="nm" />
                            <StackPanel
                                Grid.Column="4"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Text="{Binding Result}" />
                                <TextBlock Opacity="0.7" Text="{Binding SuggestionText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <Button
                    Padding="8,2"
                    Command="{Binding TakeSuggestionsCommand}"
                    Content="Take suggestions for unassigned filters" />
                <Button
                    Margin="8,0,0,0"
                    Padding="8,2"
                    Command="{Binding ReloadFiltersCommand}"
                    Content="Reload filter list" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
