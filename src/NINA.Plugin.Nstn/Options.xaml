<ResourceDictionary
    x:Class="NINA.Plugin.Nstn.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.Nstn"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:nstn="clr-namespace:NINA.Plugin.Nstn">

    <!--  NINA looks the options page up as AssemblyTitle + "_Options"; the data context is NstnPlugin.  -->
    <DataTemplate x:Key="NSTN – Narrowband Saves The Night_Options">
        <StackPanel Margin="5" Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,10"
                Text="{nstn:T Options_Intro}"
                TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{nstn:T Options_Sqm}" />
                <ninactrl:UnitTextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding SkyQuality, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{nstn:T Options_SqmHint}" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{nstn:T Options_ThresholdBroadband}" />
                <ninactrl:UnitTextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding ThresholdBroadband, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{nstn:T Options_ThresholdBroadbandHint}" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{nstn:T Options_ThresholdNarrowband}" />
                <ninactrl:UnitTextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding ThresholdNarrowband, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="mag/″²" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{nstn:T Options_ThresholdNarrowbandHint}" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{nstn:T Options_MinAltitude}" />
                <ninactrl:UnitTextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding MinimumAltitude, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="°" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{nstn:T Options_MinAltitudeHint}" />

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{nstn:T Options_Overhead}" />
                <ninactrl:UnitTextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="5,2"
                    Text="{Binding OverheadSeconds, UpdateSourceTrigger=LostFocus}"
                    TextAlignment="Right"
                    Unit="s" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{nstn:T Options_OverheadHint}" />
            </Grid>

            <TextBlock
                Margin="0,10,0,0"
                FontWeight="SemiBold"
                Text="{Binding ThresholdWarning}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThresholdWarning}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock
                Margin="0,10,0,0"
                Opacity="0.8"
                Text="{Binding NarrowbandFloorText}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Opacity="0.8"
                Text="{nstn:T Options_SiteNote}"
                TextWrapping="Wrap" />

            <!--  What each filter of the profile passes, for "From this block's filter" in the condition.  -->
            <TextBlock
                Margin="0,18,0,4"
                FontWeight="Bold"
                Text="{nstn:T Options_FiltersTitle}" />
            <TextBlock
                Opacity="0.8"
                Text="{nstn:T Options_FiltersIntro}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Opacity="0.8"
                Text="{nstn:T Options_NoFilters}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProfileFilters}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding FilterRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding NinaName}"
                                TextTrimming="CharacterEllipsis" />
                            <ComboBox
                                Grid.Column="1"
                                Margin="5,0"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Source={x:Static local:FilterAssignmentRow.Choices}}"
                                SelectedValue="{Binding Choice}"
                                SelectedValuePath="Name" />
                            <ComboBox
                                Grid.Column="2"
                                Margin="5,0"
                                DisplayMemberPath="Label"
                                IsEnabled="{Binding HasLine}"
                                ItemsSource="{Binding AvailableBands}"
                                SelectedValue="{Binding Line}"
                                SelectedValuePath="Key" />
                            <ninactrl:UnitTextBox
                                Grid.Column="3"
                                Margin="5,0"
                                IsEnabled="{Binding IsBandwidthEditable}"
                                Text="{Binding BandwidthNm, UpdateSourceTrigger=LostFocus}"
                                TextAlignment="Right"
                                Unit="nm" />
                            <StackPanel
                                Grid.Column="4"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Text="{Binding Result}" />
                                <TextBlock Opacity="0.7" Text="{Binding SuggestionText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <Button
                    Padding="8,2"
                    Command="{Binding TakeSuggestionsCommand}"
                    Content="{nstn:T Options_TakeSuggestions}" />
                <Button
                    Margin="8,0,0,0"
                    Padding="8,2"
                    Command="{Binding ReloadFiltersCommand}"
                    Content="{nstn:T Options_Reload}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
